# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES FOR RENDER
# -----------------------------------------------------------------------------
# ⚠️ IMPORTANT: Update the placeholder values (YOUR_...) before deploying!
# You can copy and paste this entire file into Render's "Environment Variables" 
# bulk editor or use it as a Secret File named .env
# -----------------------------------------------------------------------------

# --- Server Config ---
NODE_ENV=production
# Render will automatically assign a PORT, but you can set this if needed.
PORT=4000

# --- Database & Cache ---
# Replace with your actual MongoDB Atlas connection string including the DB name
MONGO_URI=mongodb+srv://levy:123456789dl@cluster0.rdgzpad.mongodb.net/sportive?retryWrites=true&w=majority&appName=Cluster0
# Your Upstash Redis URL
REDIS_URL=rediss://default:gQAAAAAAAQ8ZAAIgcDFjYWQ1NzM3NDVlNjQ0YjIxYTZjZjg4YWZhMmVjMWU1ZA@honest-penguin-69401.upstash.io:6379

# --- Authentication ---
# Generate strong random strings for these in production!
JWT_SECRET=production_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=production_super_secret_refresh_key_here
REFRESH_TOKEN_EXPIRES_IN=30d

# --- CORS & Frontend ---
# Replace this with your actual deployed frontend URL (e.g., Vercel, Netlify)
CLIENT_URL=https://webapp-sale-badminton.vercel.app

# --- VNPay Config ---
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Replace YOUR_BACKEND_DOMAIN.onrender.com with your actual Render URL
VNPAY_RETURN_URL=https://YOUR_BACKEND_DOMAIN.onrender.com/api/payment/vnpay-return

# --- MoMo Config ---
MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
# Return URL should point to your Frontend checkout/success page
MOMO_RETURN_URL=https://YOUR_FRONTEND_DOMAIN.com/checkout?payment_status=momo
# IPN URL should point to your Backend Render webhook
MOMO_IPN_URL=https://YOUR_BACKEND_DOMAIN.onrender.com/api/payment/momo-ipn
